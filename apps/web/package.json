{
  "name": "@riftkeeper/web",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate && wrangler deploy --dry-run --outdir .output/worker",
    "preview": "wrangler dev",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.worker.json",
    "test": "bun test unit",
    "test:e2e": "playwright test",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "test:production": "playwright test --config playwright.production.config.ts",
    "verify:live": "node verify-live/cli.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@riftkeeper/cards": "workspace:*",
    "@riftkeeper/search": "workspace:*",
    "@riftkeeper/ui": "workspace:*",
    "nuxt": "^4.6.3",
    "satori": "0.32.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.154.0"
  }
}
